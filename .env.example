# Model authentication is managed by the installed CLI, not Cocogem.
# No model API key is required by the web server.
# Optional: Brave Search key. If omitted, the keyless public fallback
# (Bing RSS, then DuckDuckGo HTML) is used for online discovery.
BRAVE_SEARCH_API_KEY=
# auto (default), brave, bing, duckduckgo, public or off.
# COCOGEM_SEARCH_PROVIDER=auto
# Optional public-web proxy: an http/https/socks5 URL, "env" to reuse
# HTTPS_PROXY/HTTP_PROXY, or "system" to reuse the macOS-configured proxy
# (host/port only; no PAC, subscription or credentials). Without it, requests
# go out directly; make dev selects "system" when unset. The resolved value is
# also passed to native-web CLI children only; loopback MCP stays direct and
# existing NO_PROXY entries are preserved.
# COCOGEM_WEB_PROXY=env
# COCOGEM_DATA_DIR=/absolute/path/to/private/cocogem-data
# Independent conversations may execute together; one conversation still has
# at most one active run. Default 4, allowed range 1–16.
# COCOGEM_MAX_PARALLEL_RUNS=4
# Fallback shared-history window for members without an explicit context_size.
# The defaults hold several discussion rounds (128 messages / 64,000 estimated
# tokens). A member's context_size scales its own window to 60% of that token
# budget. The estimator is conservative and provider tokenizers may differ.
# COCOGEM_HISTORY_MESSAGES=128
# COCOGEM_HISTORY_TOKENS=64000
# Long-task limits (Go duration syntax). Run and step wall-clock limits are
# disabled by default; a positive duration enables them. Explicit 0 keeps a
# check disabled, while negative or invalid values refuse startup.
# COCOGEM_RUN_TIMEOUT=0
# COCOGEM_STEP_TIMEOUT=0
# COCOGEM_FIRST_RESPONSE_TIMEOUT=10m
# COCOGEM_STALL_TIMEOUT=15m
# warn (default) only reports stalled execution; stop also terminates the step.
# A zero stall timeout disables stall detection.
# COCOGEM_STALL_ACTION=warn
